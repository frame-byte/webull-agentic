# dryrun = simulated fills using live Webull quotes; live = real orders
MODE=dryrun
# Long random string; also goes in each TradingView alert message. Generate with: openssl rand -hex 24
WEBHOOK_SECRET=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
# Where the Webull SDK keeps its 2FA token (must be persistent storage)
WEBULL_OPENAPI_TOKEN_DIR=/data/webull-token

DB_PATH=/data/trading.db
STRATEGIES_PATH=config/strategies.yaml

# Set true only when a reverse proxy (Caddy/nginx/Cloud Run) sits in front and sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
ENFORCE_IP_ALLOWLIST=true

MAX_SIGNAL_AGE_S=60
MAX_PRICE_DEVIATION_PCT=1.5
LIMIT_BAND_PCT=0.3
MAX_ORDERS_PER_DAY=20
MAX_DAILY_LOSS_PCT=3.0
ORDER_TIMEOUT_S=120

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
